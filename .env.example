# Local upstream application
TOOLSHOP_UI_BASE_URL=http://localhost:4200
TOOLSHOP_API_BASE_URL=http://localhost:8091

# Seeded local admin account, used only to clean up generated users.
TOOLSHOP_ADMIN_EMAIL=admin@practicesoftwaretesting.com
TOOLSHOP_ADMIN_PASSWORD=welcome01

# Browser and network behavior
TOOLSHOP_HEADLESS=true
TOOLSHOP_ACTION_TIMEOUT_MS=10000
TOOLSHOP_NAVIGATION_TIMEOUT_MS=30000
TOOLSHOP_API_TIMEOUT_MS=30000

# Retry only transient API failures; pytest reruns are enabled explicitly in CI.
TOOLSHOP_API_MAX_ATTEMPTS=3
TOOLSHOP_API_RETRY_INITIAL_DELAY_SECONDS=0.2
TOOLSHOP_API_RETRY_MAX_DELAY_SECONDS=2.0
